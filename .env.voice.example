# Sinalização WebRTC (opcional). Sem isto o cliente usa o Railway de produção,
# que está hardcoded como fallback em lib/voice-chat.ts.
NEXT_PUBLIC_SIGNALING_URL=https://voice.example.com

# TURN não vive mais aqui. A Cloudflare Realtime emite credenciais de curta
# duração, geradas sob demanda por /api/turn-credentials. Configure com:
#   npx wrangler secret put TURN_KEY_ID --name caju-os
#   npx wrangler secret put TURN_KEY_API_TOKEN --name caju-os
