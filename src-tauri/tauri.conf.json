{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Caju OS",
  "version": "0.1.6",
  "identifier": "net.cajutech.operacoes",
  "build": {
    "devUrl": "https://operacoes.cajutech.net",
    "frontendDist": "https://operacoes.cajutech.net"
  },
  "app": {
    "windows": [{
      "title": "Caju OS - Central de Operações",
      "width": 1440,
      "height": 900,
      "minWidth": 1024,
      "minHeight": 650,
      "resizable": true,
      "decorations": false,
      "shadow": true
    }],
    "security": { "csp": null, "capabilities": ["desktop-controls"] }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.ico", "icons/icon.png", "icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png"],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico"
      }
    }
  }
}
