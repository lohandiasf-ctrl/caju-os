{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Caju OS",
  "version": "0.1.0",
  "identifier": "net.cajutech.operacoes",
  "build": {
    "devUrl": "https://operacoes.cajutech.net",
    "frontendDist": "https://operacoes.cajutech.net"
  },
  "app": {
    "windows": [{
      "title": "Caju OS - Central de Operações",
      "width": 1440,
      "height": 900,
      "minWidth": 1024,
      "minHeight": 650,
      "resizable": true
    }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "windows": { "webviewInstallMode": { "type": "downloadBootstrapper" } }
  }
}
